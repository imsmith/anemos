# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
anemos-*.tar

# Git worktrees
/.worktrees/

# Elixir bookkeeping
*.beam

# mix.lock is deliberately NOT ignored. It was listed here while `comn` was a
# path dependency, when the lock recorded nothing about the one dependency that
# mattered. Now that comn is a git dep, the lock is what pins its commit, so
# ignoring it would throw away the reproducibility the pin exists to give.
# (The entry was inert anyway — the file is tracked, and .gitignore does not
# apply to tracked files — but it read as an instruction to untrack it.)

